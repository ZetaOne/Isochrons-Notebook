am(v)=0.1*(v+40)/(1-exp(-(v+40)/10))
bm(v)=4*exp(-(v+65)/18)
an(v)=0.01*(v+55)/(1-exp(-(v+55)/10))
bn(v)=0.125*exp(-(v+65)/80)
minf(v)=am(v)/(am(v)+bm(v))
v[0..199]'=iapp-gna*minf(v[j])^3*(0.8-n[j])*(v[j]-ena)-gk*n[j]^4*(v[j]-ek)-gl*(v[j]-el)
n[0..199]'=an(v[j])*(1-n[j])-bn(v[j])*n[j]
par iapp=10,gna=120,gk=36,gl=0.3,ena=50,ek=-77,el=-54.4
@ dt=0.01,meth=rungekutta,maxstor=400000
done
